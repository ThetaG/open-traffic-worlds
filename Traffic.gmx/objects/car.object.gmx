        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (!instance_position(global.grid_size*floor(x/global.grid_size) + global.grid_size/2,global.grid_size*floor(y/global.grid_size) + global.grid_size/2,business))
    {
    global.tempindex = index;
    with (instance_create(x,y,car_explosion))
