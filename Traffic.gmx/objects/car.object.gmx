    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//global.cararray[floor(x/global.grid_size),floor(y/global.grid_size)] = true;

if (direction == 0 || direction == 180)
    {
    eastwest = true;
    }
else
    {
    eastwest = false;
    }
    
if (stalltimer &gt; 120)
    {
    car_build_grid();
    
    newpath = path_add();
    is_path = mp_grid_path(grid, newpath, x, y, targetx, targety, false);
    
    if (is_path)
        {
        path_end();
        path_assign(path,newpath);
        path_start(path, 0, path_action_stop, false);
        arclength = path_get_length(path);
        }
    path_delete(newpath);
    stalltimer = 0;
    }

testx = x;
testy = y;
posinc = 0.001;
relpos = 0;

while ((floor(testx/global.grid_size) == floor(x/global.grid_size)) &amp;&amp; (floor(testy/global.grid_size) == floor(y/global.grid_size)) &amp;&amp; ((path_position + relpos) &lt; 1))
    {
    relpos += posinc;
    testx = path_get_x(path,path_position + relpos);
    testy = path_get_y(path,path_position + relpos);
    }

testi = floor(testx/global.grid_size);
testj = floor(testy/global.grid_size);

can_move = true;

if (global.cararray[testi,testj])
    {
    can_move = false;
    }

if (instance_position(global.grid_size*testi + global.grid_size/2,global.grid_size*testj + global.grid_size/2,road))
    {
    if (instance_position(global.grid_size*testi + global.grid_size/2,global.grid_size*testj + global.grid_size/2,road).is_intersection)
        {
        othereastwest = instance_position(global.grid_size*testi + global.grid_size/2,global.grid_size*testj + global.grid_size/2,road).eastwest;
        
        if (eastwest != othereastwest)
            {
            can_move = false;
            }
        }
    }
else
    {
    can_move = false;
    }
if (instance_position(global.grid_size*testi + global.grid_size/2,global.grid_size*testj + global.grid_size/2,business))
    {
    can_move = true;
    }
    


if (can_move)
    {
    path_speed += accel;
    if (path_speed &gt; max_speed)
        {
        path_speed = max_speed;
        }
    stalltimer = 0;
    }
else
    {
    path_speed = 0;
    stalltimer += 1;
    }
    
if (path_position == 1)
    {
    instance_destroy();
    }
    

</string>
          </argument>
        </arguments>
      </action>
    </event>
