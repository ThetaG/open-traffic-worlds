            <kind>1</kind>
            <string>max_speed = 6;
accel = 0.1;
path_speed = 0;
can_move = true;
eastwest = false;

stalltimer = 0;


index = instance_position(x,y,home).index;

arclength = 1;

car_build_grid();
    
path = path_add();
is_path = mp_grid_path(grid, path, x, y, targetx, targety, false);
if (is_path)
    {
    path_start(path, 0, path_action_stop, false);
    arclength = path_get_length(path);
    }
else
    {
    instance_destroy();
    }



</string>
          </argument>
