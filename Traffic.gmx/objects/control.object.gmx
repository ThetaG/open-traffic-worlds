<object>
  <spriteName>&lt;undefined&gt;</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>-100</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//debug
//file_delete("savegame.ini");
loadworkedstr = "no string";
flowtest_mode = false;  //should be false for actual game

running_flowtest_total = 0;
running_flowtest_count = 0;
flowtest_average = 0;

easy_mode = false;
//colorblind_xofs = 0.1;
//colorblind_yofs = 0.1;
//colorblind_xofs2 = 0.6;
//colorblind_yofs2 = 0.1;
colorblind_alph = 0.9;

maxi = 40;
maxj = 26;


boardx = 0;
boardy = 0;
boardwidth = room_width;
boardheight = room_height;

maxindices = 5;
maxintersectiontypes = 4 + maxindices;  //includes 0 as an "intersection type"

//balance area
avghometimer = 200;  //actually, a max  //40 //80 //120  //150 //200
rush_effect = 100;  //30 //60  //90  //120
hometimerdev = 20;  //5 //12  //17  //21

cartimermax = 16; //16
cartimerdecay = 2;  //2
cartimermin = 2;  //2
//caraccel = 1/40;  //1/4

max_houses_per_index = 4;
maxalarms = 3;

recalculate_chance = 50;  //percent

intersectiontimerdefault = 120;

newobsalarm = 120;  //average duration for obstacle creation alarm  120
newobsalarmdev = 40; //deviation  40
obsgenchance = 8;  //percentage  8

newbuildingalarm = 120;  //average duration for building creation alarm  80 120
newbuildingalarmdev = 40;  //deviation 40
buildinggenchance = 20*(!flowtest_mode); //percentage  8,12, 15, 20
is_business_chance = 40;  //percentage, makes a new business on board and allows for different indexed houses
                            //40
flow_ratio_compute_interval = 800;  //how often to reset counts of cars in, out
day_interval = 800;
flow_ratio_normalization = 1.12*(!flowtest_mode) + 1*flowtest_mode;  //0.94  //1.25  //1.38

initial_money = 10000; //10000
roadcost = 50;
car_revenue = 16;  //2 5 7 7 5 8 16
base_maintenance_fee = 250;  //10 //200 //300  //250
maintenance_increment = 0.25; //0.1, 0.05, 0.01, 0.2, 0.5, 0.25

loan_amount = 1000000;



//keys
intersection_holdkey = vk_control;
hotkey_select = 1;
pause = true;
menupresent = true;
menudecay = false;
menualpha = 1;
gamestarted = false;
multigate_mode = false;
current_multigate = 0;
//current_multigate = (basegate(0) | basegate(1));
for (testindex = 1; testindex &lt;= maxindices ; testindex += 1)
    {
    current_gatelist[maxindices - testindex] = 0;
    current_lcdlist[maxindices - testindex] = maxindices - testindex + 1;
    }
last_building_i = -1;
last_building_j = -1;
last_building_index = 0;






gridsize = floor(boardwidth/maxi);
textsize = font_get_size(cent_goth);
randomize();
//mouseblink = true;
//alarm[8] = 20;


//flow ratio computation
cars_in = 0;
cars_out = 0;
total_homes = 0;
alarm[2] = flow_ratio_compute_interval;
flow_ratio = 0;
normalized_flow_ratio = 0;

//for rush hour variation and day/week
timeofday = 0;
daynumber = 1;
weeknumber = 1;

//money init
money = initial_money;
moneystring = "";
moneystringalpha = 1;
moneystringcolor = c_green;
roadcount = 0;
maintenance_fee = 0;

for (i = 0; i &lt; maxi ; i += 1)
    {
    for (j = 0; j &lt; maxj ; j += 1)
        {
        //initialize all arrays
        roadarray[maxi-1-i,maxj-1-j] = 0;
        cararray[maxi-1-i,maxj-1-j] = 0;
        buildingarray[maxi-1-i,maxj-1-j] = 0;
        
        pathiarray[maxi-1-i,maxj-1-j] = ds_list_create();
        pathjarray[maxi-1-i,maxj-1-j] = ds_list_create();
        pathposarray[maxi-1-i,maxj-1-j] = 0;
        pathmaxposarray[maxi-1-i,maxj-1-j] = 0;
        
        cartimerarray[maxi-1-i,maxj-1-j] = 0;
        cartimersetarray[maxi-1-i,maxj-1-j] = 0;
        
        hometimerarray[maxi-1-i,maxj-1-j] = ceil(new_home_timer()/10);
        
        intersectionarray[maxi-1-i,maxj-1-j] = 0;
        intersectiontimerarray[maxi-1-i,maxj-1-j] = intersectiontimerdefault;
        intersectionstatearray[maxi-1-i,maxj-1-j] = true;
        intersectiontimerset1array[maxi-1-i,maxj-1-j] = intersectiontimerdefault;
        intersectiontimerset2array[maxi-1-i,maxj-1-j] = intersectiontimerdefault;
        
        obstaclearray[maxi-1-i,maxj-1-j] = 0;
        
        placedwhilepaused[maxi-1-i,maxj-1-j] = true;
        }
    }
    
shuffleposi = ds_list_create();
shuffleposj = ds_list_create();

for (ii = 0 ; ii &lt; maxi ; ii += 1)
    {
    ds_list_add(shuffleposi,ii);
    }
for (jj = 0 ; jj &lt; maxj ; jj += 1)
    {
    ds_list_add(shuffleposj,jj);
    }
    
ds_list_shuffle(shuffleposi);
ds_list_shuffle(shuffleposj);
    
create_random_obstacle();
    
grid = mp_grid_create(0,0,maxi,maxj,gridsize,gridsize);
path = path_add();
//for moving cars and transferring the lists
temppathi = ds_list_create();
temppathj = ds_list_create();


//index array
indexlist = ds_list_create();

for (ii = 0; ii &lt; maxindices; ii += 1)
    {
    ds_list_add(indexlist,ii + 1);
    housecountarray[maxindices - 1 - ii] = 0;
    }
ds_list_shuffle(indexlist);

for (testindex = 1; testindex &lt;= maxindices ; testindex += 1)
    {
    business_loc_i[testindex] = -1;
    business_loc_j[testindex] = -1;
    }

testindex = ds_list_find_value(indexlist,0);
create_random_building(testindex,buildingarray,business_loc_i,business_loc_j,true);

repeat(1 + 7*flowtest_mode)  
    create_random_building(-testindex,buildingarray,business_loc_i,business_loc_j,true);


    
volatile = true;
intersection_double_volatile = true;
intersectionhold = 0;
intersectionholdi = -1;
intersectionholdj = -1;



//set alarms for generation
indices_on_board = 1;
alarm[0] = newobsalarm - newobsalarmdev + irandom(2*newobsalarmdev);
alarm[1] = newbuildingalarm - newbuildingalarmdev + irandom(2*newbuildingalarmdev);


for (ii = 0; ii &lt; maxalarms; ii += 1)
    {
    storealarm[maxalarms-1-ii] = alarm[ii];
    }
    
//ini_open("savegame.ini");
save_exists = 1;
//save_exists = ini_read_real('SaveExists','SaveExists',0);
//ini_close();
menuindex = testindex;
set_menu();

last_new_index_spawned = -1;


//testloadstring = "test loading"


//intersection_temp_timer = 0;


/*    
startclicking = true;
mousepath = path_add();
mouselisti = ds_list_create();
mouselistj = ds_list_create();
*/


</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="1" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>for (i = 0; i &lt; maxi ; i += 1)
    {
    for (j = 0; j &lt; maxj ; j += 1)
        {
        ds_list_destroy(pathiarray[maxi-1-i,maxj-1-j]);
        ds_list_destroy(pathjarray[maxi-1-i,maxj-1-j]);
        }
    }
    
mp_grid_destroy(grid);
path_delete(path);

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>flow_ratio = compute_flow_ratio(cars_out);
normalized_flow_ratio = flow_ratio/flow_ratio_normalization;

cars_in = 0;
cars_out = 0;
alarm[2] = flow_ratio_compute_interval;

running_flowtest_total += normalized_flow_ratio;
running_flowtest_count += 1;

flowtest_average = running_flowtest_total/running_flowtest_count;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="1">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>alarm[1] = newbuildingalarm - newbuildingalarmdev + irandom(2*newbuildingalarmdev);

if (cont_percent_roll(min(normalized_flow_ratio*buildinggenchance,100)))
    {
    is_new_business = percent_roll(is_business_chance);
    
    if (is_new_business &amp;&amp; (last_new_index_spawned &gt; -1))
        {
        is_new_business = false;
        }
       
    if (is_new_business)
        {
        if (indices_on_board &lt; maxindices)
            {
            indices_on_board += 1;
            testindex = ds_list_find_value(indexlist,indices_on_board - 1);
            create_random_building(testindex,buildingarray,business_loc_i,business_loc_j,false);
            last_new_index_spawned = testindex;
            }
        }   
    else
        {
        listpick = irandom(indices_on_board - 1);
        listpicktries = 0;
        if (last_new_index_spawned &gt; -1)
            {
            testindex = last_new_index_spawned;
            }
        else
            {
            testindex = ds_list_find_value(indexlist,listpick);
            }
        while ((listpicktries &lt; indices_on_board) &amp;&amp; (housecountarray[testindex-1] &gt;= max_houses_per_index))
            {
            listpick += 1;
            if (listpick &gt;= indices_on_board)
                {
                listpick = 0;
                }
            testindex = ds_list_find_value(indexlist,listpick);
            listpicktries += 1;
            }
        create_random_building(-testindex,buildingarray,business_loc_i,business_loc_j,false);
        last_new_index_spawned = -1;
        }
    
    
    }
    
ds_list_shuffle(shuffleposi);
ds_list_shuffle(shuffleposj);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>alarm[0] = newobsalarm - newobsalarmdev + irandom(2*newobsalarmdev);

if (percent_roll(obsgenchance))
    {
    create_random_obstacle();
    }
    
ds_list_shuffle(shuffleposi);
ds_list_shuffle(shuffleposj);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>mousei = min(max(floor(mouse_x/gridsize),0),maxi-1);
mousej = min(max(floor(mouse_y/gridsize),0),maxj-1);

if (!pause &amp;&amp; !menupresent)
    {
    for (shufflei = 0; shufflei &lt; maxi ; shufflei += 1)
        {
        for (shufflej = 0; shufflej &lt; maxj ; shufflej += 1)
            {
            //main loop
            
            i = ds_list_find_value(shuffleposi,shufflei);
            j = ds_list_find_value(shuffleposj,shufflej);
            
            if (buildingarray[i,j] &lt; 0)
                {
                if (hometimerarray[i,j] &lt;= 0)
                    {
                    hometimerarray[i,j] = new_home_timer();
                    cars_in += 1;
                    if (cararray[i,j] == 0)
                        {
                        //temp, should be (cararray[i,j] == 0) maybe
                        create_car(i,j,-buildingarray[i,j],cararray,pathiarray,pathjarray,pathposarray,cartimerarray,cartimersetarray,pathmaxposarray);
                        }
                        
                    }
                else
                    {
                    hometimerarray[i,j] -= 1;
                    }
                }
                
            if (cararray[i,j] &gt; 0)
                {
                if (cartimerarray[i,j] &gt; 0)
                    {
                    cartimerarray[i,j] -= 1;
                    }
                else
                    {
                    move_successful = false;
                    competed = false; 
                    if (!ds_list_empty(pathiarray[i,j]))
                        {
                        maxpos = pathmaxposarray[i,j];
                        //maxpos = ds_list_size(pathiarray[i,j]);
                        
                        if (pathposarray[i,j]+1 &lt; maxpos)
                            {
                            //try to make a move
                            inew = ds_list_find_value(pathiarray[i,j],pathposarray[i,j]+1);
                            jnew = ds_list_find_value(pathjarray[i,j],pathposarray[i,j]+1);
                            
                            /*
                            movethrough_intersection = true;
                            
                            if (onboard(inew,jnew) &amp;&amp; (intersectionarray[inew,jnew] &gt;= 1) &amp;&amp; (intersectionarray[inew,jnew] &lt;= 3) &amp;&amp; (pathposarray[i,j]+2 &lt; maxpos))
                                {
                                inew2 = ds_list_find_value(pathiarray[i,j],pathposarray[i,j]+2);
                                jnew2 = ds_list_find_value(pathjarray[i,j],pathposarray[i,j]+2);
                                
                                if !(onboard(inew2,jnew2) &amp;&amp; cararray[inew2,jnew2] == 0 &amp;&amp; (roadarray[inew2,jnew2] || (buildingarray[inew2,jnew2] == cararray[i,j])) &amp;&amp; intersection_allow(inew,jnew,inew2,jnew2,intersectionarray[inew2,jnew2],intersectionstatearray[inew2,jnew2],cararray[i,j]))
                                    {
                                    movethrough_intersection = false;
                                    }
                                }
                            */
                            
                            if (onboard(inew,jnew) &amp;&amp; cararray[inew,jnew] == 0 &amp;&amp; (roadarray[inew,jnew] || (buildingarray[inew,jnew] == cararray[i,j])) &amp;&amp; intersection_allow(i,j,inew,jnew,intersectionarray[inew,jnew],intersectionstatearray[inew,jnew],cararray[i,j]))
                                {
                                competed = (num_neighbors(inew,jnew) &gt; 1);
                                move_car(i,j,inew,jnew,cararray,pathiarray,pathjarray,pathposarray,cartimerarray,cartimersetarray,pathmaxposarray);
                                move_successful = true;
                                }
                            
                                
                            }
    
                        }
                        
                    if (move_successful)
                        {
                        cartimersetarray[inew,jnew] -= cartimerdecay;
                        //old_cartimer = cartimersetarray[inew,jnew];
                        //cartimersetarray[inew,jnew] = get_next_cartimer(old_cartimer);
                        
                        if (cartimersetarray[inew,jnew] &lt; cartimermin)
                            {
                            cartimersetarray[inew,jnew] = cartimermin;
                            }
                        if (competed)
                            {
                            cartimersetarray[i,j] = cartimermax;
                            }
                        cartimerarray[inew,jnew] = cartimersetarray[inew,jnew];
                        pathposarray[inew,jnew] += 1;
                        
                        if (pathposarray[inew,jnew] &gt;= (maxpos-1))
                            {
                            //temporary?  to clear up at business
                            cararray[inew,jnew] = 0;
                            cars_out += 1;
                            money += ceil(car_revenue*min(normalized_flow_ratio,1));
                            }
                        }
                    else
                        {
                        cartimersetarray[i,j] = cartimermax;
                        cartimerarray[i,j] = cartimersetarray[i,j];
                        
                        //possibly recalculate path
                        //if (true)
                        if (free_neighbor(i,j))
                            {
                            if (percent_roll(recalculate_chance))
                                {
                                if (calculate_path(i,j,business_loc_i[cararray[i,j]],business_loc_j[cararray[i,j]],temppathi,temppathj,false))
                                    {
                                    pathposarray[i,j] = 0;
                                    ds_list_copy(pathiarray[i,j],temppathi);
                                    ds_list_copy(pathjarray[i,j],temppathj);
                                    pathmaxposarray[i,j] = ds_list_size(pathiarray[i,j]);
                                    }
                                
                                }
                            }
                        }
                        
                    
                    }
                    
                
                
                }
            if (roadarray[i,j])
                {
                if (intersectionarray[i,j] &gt; 0)
                    {
                    if (intersectiontimerarray[i,j] &gt; 0)
                        {
                        intersectiontimerarray[i,j] -= 1;
                        }
                    else
                        {
                        if (intersectionstatearray[i,j])
                            {
                            intersectiontimerarray[i,j] = intersectiontimerset2array[i,j];
                            }
                        else
                            {
                            intersectiontimerarray[i,j] = intersectiontimerset1array[i,j];
                            }
                        intersectionstatearray[i,j] = !intersectionstatearray[i,j];
                        }
                    }
                }
                
                
            
            }
        }
        
    timeofday += 1;
    if (timeofday &gt; day_interval)
        {
        timeofday = 0;
        daynumber += 1;
        
        if (daynumber &gt; 7)
            {
            maintenance_fee = compute_maintenance_fee();
            money -= maintenance_fee;
            moneystring = "Maintenance:  -$" + string(maintenance_fee);
            moneystringalpha = 1;
            moneystringcolor = c_red;
            daynumber = 1;
            weeknumber += 1;
            }
        }
    }
else
    {
    for (ii = 0; ii &lt; maxalarms; ii += 1)
        {
        alarm[ii] = storealarm[maxalarms-1-ii];
        }
    }

if (moneystringalpha &gt; 0)
    {
    moneystringalpha -= 1/180;
    if (moneystringalpha &lt;= 0)
        {
        moneystringalpha = 0;
        }
    }
    
if (menupresent)
    {
    if (menudecay)
        {
        menualpha -= 1/15;
        if (menualpha &lt;= 0)
            {
            menualpha = 0;
            menupresent = false;
            menudecay = false;
            gamestarted = true;
            }
        }
    else
        {
        menuselect = get_menuselect();
        }
    }
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="6" enumb="56">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
