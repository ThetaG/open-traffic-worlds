    <event eventtype="6" enumb="53">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (menupresent &amp;&amp; (menuselect &gt; -1) &amp;&amp; !menudecay)
    {
    menuselected = menuselect;
    selectedfunction = menufunction[menuselected];
    menudecay = true;
    
    if (selectedfunction == 1)
        {
        //nothing
        }
    else if (selectedfunction == 2)
        {
        save_script();
        moneystring = "Game saved!";
        moneystringalpha = 1;
        moneystringcolor = c_blue;
        }
    else if (selectedfunction == 3)
        {
        load_script();
        moneystring = "Game loaded!";
        moneystringalpha = 1;
        moneystringcolor = c_blue;
        pause = true;
        if (global.musicmute)
            {
            audio_sound_gain(traffic_melody, 0, 0);
            }
        else
            {
            audio_sound_gain(traffic_melody, 1, 0);
            }
        }
    else if (selectedfunction == 4)
        {
        with (instance_create(0,0,control))
            {
            showfps = other.showfps;
            colorblind_mode = other.colorblind_mode;
            }
        instance_destroy();
        }
    }
    
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="6" enumb="51">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (!menupresent)
    {
    if (keyboard_check(intersection_holdkey))
        {
        if (onboard(mousei,mousej) &amp;&amp; roadarray[mousei,mousej] &amp;&amp; (intersectionarray[mousei,mousej] &gt; 0))
            {
            intersectionarray[mousei,mousej] = 0;
            intersectiontimerarray[mousei,mousej] = intersectiontimerdefault;
            intersectionstatearray[mousei,mousej] = true;
            intersectiontimerset1array[mousei,mousej] = intersectiontimerdefault;
            intersectiontimerset2array[mousei,mousej] = intersectiontimerdefault;
            }
        }
    else
        {
        if (onboard(mousei,mousej) &amp;&amp; !cararray[mousei,mousej])
            {
            if (roadarray[mousei,mousej])
                {
                roadarray[mousei,mousej] = false;
                intersectionarray[mousei,mousej] = 0;
                intersectiontimerarray[mousei,mousej] = intersectiontimerdefault;
                intersectionstatearray[mousei,mousej] = true;
                intersectiontimerset1array[mousei,mousej] = intersectiontimerdefault;
                intersectiontimerset2array[mousei,mousej] = intersectiontimerdefault;
                
                if (!global.soundmute)
                    {
                    audio_play_sound(delete_road,0,false);
                    }
                
                if (placedwhilepaused[mousei,mousej])
                    {
                    money += roadcost;
                    moneystring = "Road:  +$" + string(roadcost);
                    moneystringalpha = 1;
                    moneystringcolor = c_green;
                    roadcount -= 1;
                    }
                else
                    {
                    money += round(roadcost/2);
                    moneystring = "Road:  +$" + string(round(roadcost/2));
                    moneystringalpha = 1;
                    moneystringcolor = c_green;
                    roadcount -= 1;
                    }
                }
            }
        }
    }
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="6" enumb="50">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (!menupresent)
    {
    if (keyboard_check(intersection_holdkey))
        {
        if (roadarray[mousei,mousej] &amp;&amp; (intersectionarray[mousei,mousej] &gt; 0) &amp;&amp; (intersectionarray[mousei,mousej] &lt;= 3))
            {
            //if (intersectionholdi == mousei &amp;&amp; intersectionholdj == mousej)
            if (intersection_double_volatile)
                {
                intersection_double_volatile = false;
                if (!global.soundmute)
                    {
                    audio_play_sound(ctrl_adjust,0,false);
                    }
                if (intersectionstatearray[mousei,mousej])
                    {
                    intersectiontimerset1array[mousei,mousej] += intersectiontimerdefault+1;
                    global.temp_int_inc_amount = floor(intersectiontimerset1array[mousei,mousej]/intersectiontimerdefault);
                    //intersectiontimerarray[mousei,mousej] += intersectiontimerdefault;
                    }
                else
                    {
                    intersectiontimerset2array[mousei,mousej] += intersectiontimerdefault+1;
                    //intersectiontimerarray[mousei,mousej] += intersectiontimerdefault;
                    global.temp_int_inc_amount = floor(intersectiontimerset2array[mousei,mousej]/intersectiontimerdefault);
                    }
                with (instance_create(0,0,intersection_double_effect))
                    {
                    int_inc_amount = global.temp_int_inc_amount;
                    }
                /*
                intersectionhold += 1;
                if (intersectionhold == 0)
                    {
                    //intersection_temp_timer = intersectiontimerarray[mousei,mousej];
                    }
                    
                if (intersectionstatearray[mousei,mousej])
                    {
                    intersectiontimerset1array[mousei,mousej] = intersectionhold;
                    intersectiontimerarray[mousei,mousej] = 1;
                    }
                else
                    {
                    intersectiontimerset2array[mousei,mousej] = intersectionhold;
                    intersectiontimerarray[mousei,mousej] = 1;
                    }
                */
            
                }
            else
                {
                intersectionhold = 0;
                //intersectionholdi = mousei;
                //intersectionholdj = mousej;
                }
            }
        }
    else
        {
        intersectionhold = 0;
            
        if (volatile &amp;&amp; roadarray[mousei,mousej])
            {
            intersectionarray[mousei,mousej] = hotkey_select;
            if (!global.soundmute)
                {
                audio_play_sound(place_intersection,0,false);
                }
                
            //if (intersectionarray[mousei,mousej] &gt;= maxintersectiontypes)
            //    {
            //    intersectionarray[mousei,mousej] = 0;
            //    }
                
            if (intersectionarray[mousei,mousej] == 0)
                {
                intersectionstatearray[mousei,mousej] = true;
                intersectiontimerarray[mousei,mousej] = intersectiontimerdefault;
                intersectiontimerset1array[mousei,mousej] = intersectiontimerdefault;
                intersectiontimerset2array[mousei,mousej] = intersectiontimerdefault;
                }
            }
        
        if (onboard(mousei,mousej) &amp;&amp; (buildingarray[mousei,mousej] == 0) &amp;&amp; !obstaclearray[mousei,mousej])
            {
            if (!roadarray[mousei,mousej])
                {
                if (money &gt;= roadcost)
                    {
                    placedwhilepaused[mousei,mousej] = pause;
                    money -= roadcost;
                    roadarray[mousei,mousej] = true;
                    moneystring = "Road:  -$" + string(roadcost);
                    moneystringalpha = 1;
                    moneystringcolor = c_red;
                    roadcount += 1;
                    if (!global.soundmute)
                        {
                        audio_play_sound(place_road,0,false);
                        }
                    }
                else
                    {
                    moneystring = "Can't afford road!";
                    moneystringalpha = 1;
                    moneystringcolor = c_red;
                    if (!global.soundmute &amp;&amp; volatile)
                        {
                        audio_play_sound(cant_place,0,false);
                        }
                    }
                }
            }
            
        volatile = false;
        }
    }
    
    
    /*
    if (startclicking)
        {
        startclicking = false;
        oldmousex = toxy(mousei);
        oldmousey = toxy(mousej);
        }
    
    newmousex = toxy(mousei);
    newmousey = toxy(mousej);
    
    path_clear_points(mousepath);
    path_add_point(mousepath,oldmousex,oldmousey,100);
    path_add_point(mousepath,newmousex,newmousey,100);
    discretize_path(mousepath,mouselisti,mouselistj);
    
    for (k = 0; k &lt; ds_list_size(mouselisti); k += 1)
        {
        tempmousei = ds_list_find_value(mouselisti,k);
        tempmousej = ds_list_find_value(mouselistj,k);
        if (onboard(tempmousei,tempmousej) &amp;&amp; (buildingarray[tempmousei,tempmousej] == 0))
            {
            roadarray[tempmousei,tempmousej] = true;
            }
        }
    
    
        
        
    oldmousex = newmousex;
    oldmousey = newmousey;
*/
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>for (i = 0 ; i &lt; maxi ; i += 1)
    {
    for (j = 0 ; j &lt; maxj ; j += 1)
        {
        if (obstaclearray[i,j])
            {
            drawsquare(i,j,c_black,0.6);
            }
        if (roadarray[i,j])
            {
            drawsquare(i,j,c_gray,0.3);
            if (intersectionarray[i,j] &gt; 0)
                {
                drawintersection(i,j,intersectionarray[i,j],intersectionstatearray[i,j],0.3);
                }
            }
        if (buildingarray[i,j] != 0)
            {
            drawsquare(i,j,index_to_color(abs(buildingarray[i,j]),128 + 127*(buildingarray[i,j] &gt; 0),155 + 100*(buildingarray[i,j] &gt; 0)),0.7);
            if (colorblind_mode)
                {
                draw_set_halign(fa_center);
                draw_set_valign(fa_middle);
                draw_set_font(med_goth);
                draw_text_shadow((i + 1/2)*gridsize - 1,(j + 1/2)*gridsize + 1,string(abs(buildingarray[i,j])),c_black,c_white,1,colorblind_alph,0.5);
                draw_set_halign(fa_left);
                draw_set_valign(fa_top);
                }
            }
        if (cararray[i,j] &gt; 0)
            {
            drawcircle(i,j,index_to_color(cararray[i,j],128,255),0.7);
            if (colorblind_mode)
                {
                draw_set_halign(fa_center);
                draw_set_valign(fa_middle);
                draw_set_font(med_goth);
                draw_text_shadow((i + 1/2)*gridsize - 1,(j + 1/2)*gridsize + 1,string(cararray[i,j]),c_black,c_white,1,colorblind_alph,0.5);
                draw_set_halign(fa_left);
                draw_set_valign(fa_top);
                }
            }
        }
    }
    
for (i = 0 ; i &lt; maxi ; i += 1)
    {
    draw_set_alpha(0.2);
    draw_set_color(c_black);
    draw_line_width(i*gridsize,boardy,i*gridsize,boardy+boardheight,2);
    }
for (j = 0 ; j &lt; maxj ; j += 1)
    {
    draw_set_alpha(0.2);
    draw_set_color(c_black);
    draw_line_width(boardx,j*gridsize,boardx+boardwidth,j*gridsize,2);
    }

if (!menupresent)
    {
    draw_mousesquare(mousei,mousej,c_white,0.5);
    if (keyboard_check(intersection_holdkey))
        {
        draw_set_font(half_goth);
        draw_text_shadow(mousei*gridsize + 1*gridsize/4,mousej*gridsize - 1*gridsize/4,"(ctrl)",c_black,c_white,1,0.3,0.5);
        }
    if (obstaclearray[mousei,mousej] || (buildingarray[mousei,mousej] != 0))
        {
        draw_set_color(c_gray);
        draw_set_alpha(0.5);
        draw_line_width(mousei*gridsize,mousej*gridsize,(mousei+1)*gridsize,(mousej+1)*gridsize,2);
        draw_line_width((mousei+1)*gridsize,mousej*gridsize,mousei*gridsize,(mousej+1)*gridsize,2);
        }
    }


draw_set_alpha(1);

draw_set_font(cent_goth);
draw_set_halign(fa_left);
draw_text_shadow(gridsize/2,gridsize/2,"Week " + string(weeknumber) + ", " + "day " + string(daynumber),c_black,c_white,1,1,0.5);
draw_text_shadow(gridsize/2,gridsize/2 + 1.75*textsize,"Flow ratio:  " + string(min(round(normalized_flow_ratio*100),100 + 900*flowtest_mode)) + "%",c_black,c_white,1,1,0.5);
draw_set_halign(fa_right);
if (money &gt;= 0)
    draw_text_shadow(room_width-gridsize/2,gridsize/2,"Funds:  "  + "$" + string(money),c_black,c_green,1,1,0.5);
else
    draw_text_shadow(room_width-gridsize/2,gridsize/2,"Funds:  "  + "-$" + string(-money),c_black,c_red,1,1,0.5);
draw_text_shadow(room_width-gridsize/2,gridsize/2 + 1.75*textsize,moneystring,c_black,moneystringcolor,2,moneystringalpha,0.5);
draw_set_halign(fa_center);
if (pause || menupresent)
    draw_text_shadow(room_width/2,gridsize/2,"PAUSED",c_black,c_white,1,1,0.5);

    
if (multigate_mode)
    {
    draw_gateeditor(room_width/2,room_height - 3*gridsize/2,3+2/3,1,-2.5,-1,1,4 + current_multigate,"designed");
    }
    
    
if (menupresent)
    draw_menu();

draw_set_font(cent_goth);    
draw_set_halign(fa_left);
if (showfps)
    draw_text_shadow(gridsize/2,room_height - gridsize - textsize,fps,c_black,c_white,1,1,0.5);   

if (flowtest_mode)     
    draw_text_shadow(gridsize/2,room_height - gridsize/2 - 2.5*textsize,string(flowtest_average),c_black,c_white,1,1,0.5);
    
if (easy_mode)
    {
    draw_set_halign(fa_right);
    draw_text_shadow(room_width - gridsize/2,room_height - gridsize - textsize,"Easy mode",c_black,c_blue,1,1,0.5);
    draw_set_halign(fa_left);
    }
//draw_text_shadow(gridsize/2,room_height - 4*gridsize/2 - 2.5*textsize,testloadstring,c_black,c_white,1,1,0.5);

//draw_text(10,10,fps);
//draw_text(10,20,flow_ratio);
//draw_text(10,50,maintenance_fee);
//draw_text(10,40,total_homes);
//draw_text(room_width/2,40,pause);
</string>
          </argument>
        </arguments>
      </action>
    </event>
